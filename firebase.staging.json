{
  "firestore": [
    {
      "database": "fg256",
      "rules": "firestore.rules.next"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix functions run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "lib/**/*.map",
        "**/.*"
      ]
    }
  ]
}
