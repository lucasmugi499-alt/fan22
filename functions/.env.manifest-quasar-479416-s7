# Non-secret Cloud Functions configuration for the demo project.
# Secrets live in Secret Manager and are never stored here.

# Result finalizer activation. off | canary | enabled
# An unrecognised value resolves to off, so this file cannot accidentally grant authority.
#
# Stage 4, approved by the owner for the DEMO environment only on 2026-08-08 after the
# canary passed all twelve checks in the cloud. `enabled` gives the finalizer authority
# over every future eligible confirmed submission. It does not replay history: Firestore
# event triggers fire only on future writes, and no scheduled sweeper is deployed.
#
# Rollback is this line: set to `off` and redeploy the two finalizer functions.
# `canary` is retained as an operational state so authority can be narrowed without a
# code change.
#
# Narrowed to `canary` on 2026-08-09 while surplus reconciliation was corrected, and
# returned to `enabled` the same day after the surplus canary passed in the cloud: a
# contradictory result (submitted 2-0, events reconstructing 5-0) produced zero official
# records of any kind, one deterministic League-review case, and stayed idempotent across
# a duplicate delivery.
# Returned to `enabled` on 2026-08-23 after the adversarial cloud canary proved the DEPLOYED
# function rejects an oversized claim before constructing events: finalizationStatus
# blocked_oversized_submission, zero official events, one reviewable exception naming both the
# scorer cap and the write budget, no timeout.
#
# It was set to canary because the deployed function was still running source uploaded
# 2026-08-19 — six commits behind the repository — while a status report claimed the fix was
# live because App Hosting had rolled out. An App Hosting rollout does not update a Cloud
# Function. Verify the function's own source generation, not the app revision.
GOALPLACE_FINALIZER_MODE=enabled

# Submission ids the finalizer may process while in canary mode. Ignored while the mode
# is `enabled`; kept populated-empty so returning to `canary` is one word, not a rewrite.
GOALPLACE_FINALIZER_CANARY_SUBMISSION_IDS=

# App Hosting origin the scheduled jobs call. Public URL, not a credential.
GOALPLACE_PAYMENT_CALLBACK_BASE_URL=https://fan22--manifest-quasar-479416-s7.us-east4.hosted.app

# ---------------------------------------------------------------------------
# Field capture activation. off | canary | enabled
#
# Split out from GOALPLACE_FINALIZER_MODE on 2026-08-26. Until then one variable governed
# every intake path, and it read `enabled` because the BILATERAL V1 finalizer had been
# cloud-verified on this project since 2026-08-08. onMatchReportWritten was then deployed
# under that same word, which armed a pipeline that had never once run against real data:
# the next ordinary field report anybody wrote would have produced an official result, with
# standings, athlete projections and Fantasy points behind it, and no human step anywhere.
#
# Turning the shared flag down to `canary` would have protected field capture by degrading a
# finalizer that had been working for weeks. Two pipelines at two maturities need two
# switches, so they now have them.
#
# `canary` with an empty allowlist is the provably inert state: the gate is closed for every
# match id, and opening it for exactly one is a one-line change to the list below rather than
# a change of mode. It stays here until the good canary and the bad canary have both been
# verified in the cloud, and only then becomes `enabled`.
GOALPLACE_FIELD_CAPTURE_MODE=canary

# Match ids field capture may finalize while in canary mode. Trusted configuration, never a
# field on the report: a client-writable marker would make the device that produced the claim
# part of the authority that publishes it.
GOALPLACE_FIELD_CAPTURE_CANARY_MATCH_IDS=match_eurdl_18_03

# League post-match entry activation. off | canary | enabled
#
# The third source, deployed 2026-08-26 and never cloud-verified either. `off` rather than
# `canary` because it is not the pipeline being proven in this milestone: `canary` would read
# as "a canary is imminent", and none is planned. It gets its own readiness on its own day.
GOALPLACE_LEAGUE_ENTRY_MODE=off

GOALPLACE_LEAGUE_ENTRY_CANARY_MATCH_IDS=

# ---------------------------------------------------------------------------
# Team authority sunset stage. active | frozen | retired
#
# Set to `retired` on 2026-08-26, after the V1 drain read zero on both blocking counts
# (18 stranded claims migrated to league resolution first). See the milestone runbook.
#
# This runtime needs it because `convergeLifecycle` rebuilds access projections hourly, and
# `projectScopeIndex` reads this variable to decide what a team bundle grants. Rebuilding the
# stored projections while THIS runtime still read `frozen` would have undone the migration
# one user at a time: the sweep would compute a desired projection that still carried team
# capabilities, see it disagree with the retired document, and write the capabilities back.
# `access:sunset-invariants` would have passed on the day and failed a week later with
# nothing having changed.
#
# An unrecognised value falls back to `frozen`. A typo must not retire anybody's authority,
# and it must not silently un-retire it either.
GOALPLACE_TEAM_AUTHORITY_STAGE=retired
