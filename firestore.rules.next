rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Two rules this file no longer contains, and the reasons.
    //
    // 1. NO BROWSER DELETES, for anyone, including super_admin. A stolen super_admin session
    //    could previously delete result submissions and their nested events — the append-only
    //    provenance that explains who submitted a result, who disputed it and how it changed.
    //    That is history destruction wearing an administrator's badge. Exceptional deletion
    //    (legal, privacy) belongs in a break-glass command with reauthentication, an explicit
    //    target, a reason and a tombstone — not in a browser credential.
    //
    // 2. NO ROLE-ONLY PLATFORM WRITES. `isPlatformAdmin()` grants on a role claim alone, so a
    //    Platform Admin browser could edit teams, leagues, athletes, sponsors and users
    //    directly, skipping the command layer's capability check, validation, reason and
    //    audit entry. A governance model that the browser can walk around is not a governance
    //    model. Collections owned by platform commands are closed here; scoped operator
    //    capabilities (hasScopeCapability) are untouched, because those ARE the canonical
    //    model rather than a bypass of it.

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', null) : null;
    }

    function isPlatformAdmin() {
      return role() == 'platform_admin' || role() == 'super_admin';
    }

    // `isSuperAdmin()` was removed on 2026-08-23, and its absence is the point.
    //
    // Its only remaining use was authorizing browser deletes. Now that provenance cannot be
    // deleted from a client at all, super_admin has no rules-level privilege whatsoever —
    // which is the correct model: super_admin is enormous COMMAND authority, exercised
    // through audited server commands, not a browser credential that can reach past them.
    // A future rule needing it should be treated as a design smell, not a missing helper.

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /**
     * Canonical authority.
     *
     * `accessIndex` document ids are deterministic — `{scopeType}_{scopeId}_{uid}` — so a
     * scope check is a direct lookup rather than a scan, and it costs fewer document
     * accesses than the exists()+get() pair on the league/team document it replaces.
     *
     * The index is written only by the server-side projector, and only as a deterministic
     * projection of active accessAssignments. Revoked, suspended and expired assignments
     * are excluded, and the document is DELETED when no active assignment remains — so
     * absence is a real denial, not an empty allow.
     *
     * Deliberately NOT `legacy OR canonical`: a stale adminUserIds entry would keep
     * authorizing a user whose assignment had been revoked, which is the one failure this
     * migration exists to remove. Availability is protected instead by backfilling every
     * legacy grant before cutover (npm run access:migrate:gate).
     */
    function accessIndexPath(scopeType, scopeId) {
      return /databases/$(database)/documents/accessIndex/$(scopeType + '_' + scopeId + '_' + request.auth.uid);
    }

    function scopeIndex(scopeType, scopeId) {
      return get(accessIndexPath(scopeType, scopeId)).data;
    }

    function scopeCapabilities(scopeType, scopeId) {
      return scopeIndex(scopeType, scopeId).capabilities;
    }

    // A projection past its earliest assignment expiry grants nothing.
    //
    // Without this, `validUntil` was enforced only at the moment the projector happened to
    // run: a grant that lapsed on Tuesday kept working from Monday's document until
    // something unrelated rewrote it. Rules cannot parse ISO strings, which is why the
    // projection carries `expiresAtMillis` alongside the human-readable timestamp.
    function scopeIndexLive(scopeType, scopeId) {
      return !('expiresAtMillis' in scopeIndex(scopeType, scopeId)) ||
        request.time.toMillis() < scopeIndex(scopeType, scopeId).expiresAtMillis;
    }

    function hasScopeCapability(scopeType, scopeId, capabilities) {
      return signedIn() &&
        exists(accessIndexPath(scopeType, scopeId)) &&
        scopeIndexLive(scopeType, scopeId) &&
        scopeCapabilities(scopeType, scopeId).hasAny(capabilities);
    }

    function canManageLeagueById(leagueId) {
      return isPlatformAdmin() ||
        hasScopeCapability('league', leagueId, [
          'league.profile.manage',
          'league.season.manage',
          'league.team.create',
          'league.team_admin.invite',
          'league.roster.verify',
          'league.result.resolve',
          'league.notice.publish',
        ]);
    }

    function canManageTeamById(teamId) {
      return isPlatformAdmin() ||
        hasScopeCapability('team', teamId, [
          'team.profile.manage',
          'team.staff.invite',
          'team.roster.manage',
          'team.athlete.create',
          'team.athlete.invite',
          'team.result.submit',
          'team.result.confirm',
          'team.update.publish',
        ]);
    }

    function athletePath(athleteId) {
      return /databases/$(database)/documents/athletes/$(athleteId);
    }

    function canManageAthleteById(athleteId) {
      return signedIn() &&
        exists(athletePath(athleteId)) &&
        get(athletePath(athleteId)).data.userId == request.auth.uid;
    }

    function matchPath(matchId) {
      return /databases/$(database)/documents/matches/$(matchId);
    }

    function canAccessMatchResult(matchId) {
      return signedIn() &&
        exists(matchPath(matchId)) &&
        (
          canManageLeagueById(get(matchPath(matchId)).data.leagueId) ||
          canManageTeamById(get(matchPath(matchId)).data.homeTeamId) ||
          canManageTeamById(get(matchPath(matchId)).data.awayTeamId)
        );
    }

    function submissionMatchesFixture(matchId, submission) {
      return exists(matchPath(matchId)) &&
        submission.leagueId == get(matchPath(matchId)).data.leagueId &&
        submission.seasonId == get(matchPath(matchId)).data.seasonId &&
        (
          (
            submission.submittedByTeamId == get(matchPath(matchId)).data.homeTeamId &&
            submission.opponentTeamId == get(matchPath(matchId)).data.awayTeamId
          ) ||
          (
            submission.submittedByTeamId == get(matchPath(matchId)).data.awayTeamId &&
            submission.opponentTeamId == get(matchPath(matchId)).data.homeTeamId
          )
        );
    }

    function newSubmissionFields() {
      return [
        'matchId', 'leagueId', 'seasonId', 'submittedByTeamId', 'opponentTeamId',
        'submittedByUserId', 'homeScore', 'awayScore', 'scorers', 'activeSquads',
        'athleteStatLines', 'evidenceRefs', 'evidenceNote', 'status', 'revision', 'submittedAsFinal',
        'confirmationDeadline', 'resultVersion', 'submittedAt'
      ];
    }

    function validNewSubmission(matchId) {
      return request.resource.data.keys().hasOnly(newSubmissionFields()) &&
        matchId == request.resource.data.matchId &&
        submissionMatchesFixture(matchId, request.resource.data) &&
        request.resource.data.submittedByTeamId != request.resource.data.opponentTeamId &&
        request.resource.data.status == 'pending_confirmation' &&
        request.resource.data.submittedByUserId == request.auth.uid &&
        request.resource.data.homeScore is int &&
        request.resource.data.homeScore >= 0 &&
        request.resource.data.awayScore is int &&
        request.resource.data.awayScore >= 0 &&
        request.resource.data.scorers is list &&
        // Size caps, not just type checks.
        //
        // The finalizer expands these lists into squad, scoring and stat events inside one
        // transaction. Unbounded input is an unbounded write plan; a plan over Firestore's
        // operation budget fails, the trigger retries, and one oversized document becomes a
        // permanently retrying function with the match stuck out of official state. The
        // ceilings are generous by design — they stop amplification, they do not referee
        // team sheets. Mirrored in src/lib/sport/submissionLimits.ts.
        request.resource.data.scorers.size() <= 60 &&
        request.resource.data.homeScore <= 300 &&
        request.resource.data.awayScore <= 300 &&
        (!request.resource.data.keys().hasAny(['activeSquads']) || (
          request.resource.data.activeSquads is map &&
          request.resource.data.activeSquads.keys().size() <= 2
        )) &&
        (!request.resource.data.keys().hasAny(['athleteStatLines']) || (
          request.resource.data.athleteStatLines is list &&
          request.resource.data.athleteStatLines.size() <= 120
        )) &&
        request.resource.data.evidenceRefs is list &&
        request.resource.data.evidenceRefs.size() <= 20 &&
        get(matchPath(matchId)).data.status in ['completed', 'live'] &&
        get(matchPath(matchId)).data.verificationStatus != 'verified' &&
        !('officialResultVersion' in get(matchPath(matchId)).data) &&
        request.resource.data.revision is int &&
        request.resource.data.revision >= 1 &&
        request.resource.data.resultVersion is int &&
        request.resource.data.resultVersion >= 1 &&
        request.resource.data.submittedAsFinal == true &&
        request.resource.data.confirmationDeadline is string &&
        request.resource.data.submittedAt is string;
    }

    // Fields that describe the original claim. Once submitted they are immutable: an
    // adjudicated score is written to correctedHomeScore/correctedAwayScore so the claim
    // and the ruling both survive for audit.
    function submissionClaimFields() {
      return [
        'matchId', 'leagueId', 'seasonId', 'submittedByTeamId', 'opponentTeamId',
        'submittedByUserId', 'homeScore', 'awayScore', 'scorers', 'revision', 'submittedAt'
      ];
    }

    function claimUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(submissionClaimFields());
    }

    function changedKeysWithin(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    match /sports/{sportId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      // The key allowlist is a hardening the deployed ruleset has and this one had lost.
      //
      // It is restored here with the fields the live registration path actually writes —
      // `accountClass` and `pendingInvitationPath` included, which the deployed list is
      // missing. That omission is not cosmetic: the deployed rules reject the exact document
      // /register produces, so restoring the stale list verbatim would have traded one
      // loosening for a broken signup.
      //
      // `accountClass` is self-declared at create and deliberately carries no authority:
      // every operator path re-derives it from custom claims, and `role == 'fan'` below
      // means a self-registered document can never claim an operator role.
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'role', 'accountClass', 'accountStatus',
          'pendingInvitationPath', 'status', 'points', 'walletBalance',
          'followedAthletes', 'followedTeams', 'followedLeagues',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'fan' &&
        request.resource.data.status == 'active' &&
        request.resource.data.points == 0 &&
        request.resource.data.walletBalance == 0;
      allow read: if isOwner(uid) || isPlatformAdmin();
      allow update: if
        (isOwner(uid) && changedKeysWithin([
          'name', 'displayName', 'city', 'avatarUrl', 'photoURL',
          'followedAthletes', 'followedTeams', 'followedLeagues',
          'sportPreferences', 'notificationPreferences', 'onboardingCompletedAt',
          'lowDataMode', 'updatedAt'
        ]));
      allow delete: if false;
    }

    // An athlete profile is a managed record, not an account holder's page.
    //
    // The self-edit clause that used to sit here let anyone holding `userId` rewrite their
    // own name, photo and bio. That is the wrong authority model for a public sporting
    // record: the club that put the athlete on the roster is the party that knows what is
    // true, and an athlete should not need an account to exist in the record at all. Profile
    // writes now run through the audited platform command or the team's roster authority.
    //
    // Mirrored from firestore.rules deliberately. Leaving the clause here would mean the
    // next deploy of this pending ruleset silently reinstated athlete self-editing.
    match /athletes/{athleteId} {
      allow read: if true;
      allow write: if false;
    }

    match /athleteClaims/{claimId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.requesterUserId == request.auth.uid) ||
        canManageTeamById(resource.data.teamId) ||
        canManageLeagueById(resource.data.leagueId);
      allow write: if false;
    }

    match /athleteSeasonStats/{recordId} {
      allow read: if true;
      allow write: if false;
    }

    match /athleteTeamHistory/{recordId} {
      allow read: if true;
      allow write: if false;
    }

    match /athleteVerificationRecords/{recordId} {
      allow read: if true;
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if
        (canManageLeagueById(request.resource.data.leagueId) &&
          request.resource.data.adminUserIds is list &&
          request.resource.data.adminUserIds.size() == 0 &&
          request.resource.data.verified == false);
      allow update: if
        (hasScopeCapability('team', teamId, ['team.profile.manage']) && changedKeysWithin([
          'name', 'city', 'location', 'description', 'logoUrl', 'logoURL',
          'teamAdminName', 'teamAdminEmail', 'lastUpdated', 'updatedAt'
        ]));
      allow delete: if false;
    }

    match /leagues/{leagueId} {
      allow read: if true;
      // Created by the audited server command, never from a browser.
      allow create: if false;
      allow update: if
        (hasScopeCapability('league', leagueId, ['league.profile.manage']) && changedKeysWithin([
          'name', 'city', 'description', 'logoUrl', 'logoURL',
          'currentSeasonId', 'verificationRules', 'updatedAt'
        ]));
      allow delete: if false;
    }

    // Seasons are league-owned competition containers. Publicly readable so fans can browse
    // historical tables; writes are command-owned. League and Platform Operators use the
    // trusted server command layer so the mutation can validate scope and write immutable
    // audit, while the Admin SDK bypasses these browser rules.
    match /seasons/{seasonId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Result submissions: a team's CLAIM about a match, not the official record.
    //
    // The document id must equal the matchId. That is what makes "one active submission per
    // match" atomic — two team admins submitting at once resolve by first-write-wins,
    // because the second create collides with an existing document.
    //
    // No client can write status 'official'. Promotion onto the match record is done by the
    // trusted server-side finalizer using the Admin SDK, which bypasses these rules. That
    // asymmetry is the trust boundary: team admins report, the server decides.
    /**
     * Finalizations blocked because recorded events contradict the submitted score.
     *
     * Written only by the trusted finalizer through the Admin SDK, which bypasses these
     * rules, so every client write is denied: a blocked result is evidence about official
     * data, and the governing League decides it through a reviewed command, never by
     * editing the case record. Readable by the League that has to act on it.
     *
     * Without this block the collection falls through to the catch-all, which grants read
     * to super_admin only — the League Admin queue would have rendered empty and the case
     * would have been invisible to the only people who can resolve it.
     */
    /**
     * Environment activation requests.
     *
     * Written only by the audited platform command through the Admin SDK. Every client
     * write is denied: an activation record is the evidence that a guarded process was
     * followed, so a client able to write one could manufacture an approval — including its
     * own second-operator sign-off, which is the single control the workflow exists to
     * enforce.
     */
    match /environmentActivations/{activationId} {
      allow get, list: if isPlatformAdmin();
      allow write: if false;
    }

    match /reconciliationExceptions/{exceptionId} {
      allow get, list: if isPlatformAdmin() || canManageLeagueById(resource.data.leagueId);
      allow write: if false;
    }

    match /resultSubmissions/{matchId} {
      allow get: if isPlatformAdmin() || canAccessMatchResult(matchId);
      allow list: if isPlatformAdmin() ||
        canManageLeagueById(resource.data.leagueId) ||
        canManageTeamById(resource.data.submittedByTeamId) ||
        canManageTeamById(resource.data.opponentTeamId);

      // Only an admin of the submitting team may open a claim, only against a team they are
      // not also running, and only in the awaiting-response state.
      allow create: if canManageTeamById(request.resource.data.submittedByTeamId) &&
        !canManageTeamById(request.resource.data.opponentTeamId) &&
        validNewSubmission(matchId);

      // A rejected or withdrawn claim may be replaced in place. The revision advances,
      // while the official result version remains stable because neither terminal claim
      // ever became official.
      allow update: if resource.data.status in ['rejected', 'withdrawn'] &&
        canManageTeamById(request.resource.data.submittedByTeamId) &&
        !canManageTeamById(request.resource.data.opponentTeamId) &&
        validNewSubmission(matchId) &&
        request.resource.data.revision == resource.data.revision + 1 &&
        request.resource.data.resultVersion == resource.data.resultVersion;

      // The opponent answers: confirm or dispute. They may never edit the claimed score.
      allow update: if canManageTeamById(resource.data.opponentTeamId) &&
        !canManageTeamById(resource.data.submittedByTeamId) &&
        resource.data.status in ['pending_confirmation', 'confirmation_overdue'] &&
        request.resource.data.status in ['confirmed', 'disputed'] &&
        claimUnchanged() &&
        changedKeysWithin(['status', 'respondedByUserId', 'respondedAt', 'disputeReason', 'resolution']) &&
        request.resource.data.respondedByUserId == request.auth.uid &&
        (
          (
            request.resource.data.status == 'confirmed' &&
            request.resource.data.resolution == 'opponent_confirmed'
          ) ||
          (
            request.resource.data.status == 'disputed' &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['resolution'])
          )
        );

      // The submitter may retract an unanswered claim, and nothing else.
      allow update: if canManageTeamById(resource.data.submittedByTeamId) &&
        resource.data.status == 'pending_confirmation' &&
        request.resource.data.status == 'withdrawn' &&
        claimUnchanged() &&
        changedKeysWithin(['status', 'resolvedAt', 'resolvedByUserId']);

      // The league adjudicates. It may correct a score, but only into the corrected fields,
      // and it still cannot declare a result official.
      allow update: if canManageLeagueById(resource.data.leagueId) &&
        resource.data.status in ['pending_confirmation', 'confirmation_overdue', 'confirmed', 'disputed'] &&
        // 'pending_confirmation' is how a league extends the window: it resets the clock
        // rather than deciding anything.
        request.resource.data.status in ['confirmed', 'disputed', 'rejected', 'pending_confirmation'] &&
        claimUnchanged() &&
        changedKeysWithin([
          'status', 'resolution', 'resolvedByUserId', 'resolvedAt', 'finalDecisionNote',
          'disputeReason', 'correctedHomeScore', 'correctedAwayScore',
          'confirmationDeadline', 'confirmedByUserId', 'confirmationReason', 'confirmedAt',
          'evidenceRefs', 'evidenceNote'
        ]) &&
        (
          request.resource.data.status == 'pending_confirmation' ||
          request.resource.data.resolvedByUserId == request.auth.uid
        ) &&
        (
          request.resource.data.status != 'confirmed' ||
          (
            request.resource.data.resolution == 'league_corrected' &&
            request.resource.data.correctedHomeScore is number &&
            request.resource.data.correctedHomeScore >= 0 &&
            request.resource.data.correctedAwayScore is number &&
            request.resource.data.correctedAwayScore >= 0
          ) ||
          (
            request.resource.data.resolution in [
              'league_upheld', 'league_confirmed_unresponsive'
            ] &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'correctedHomeScore', 'correctedAwayScore'
            ])
          )
        );

      allow delete: if false;

      // Append-only audit trail. Entries are never edited, so the history of a disputed
      // result cannot be rewritten after the fact.
      match /events/{eventId} {
        allow read: if isPlatformAdmin() || canAccessMatchResult(matchId);
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly([
            'submissionId', 'from', 'to', 'actor', 'actorUserId', 'note', 'createdAt'
          ]) &&
          request.resource.data.submissionId == matchId &&
          request.resource.data.actorUserId == request.auth.uid &&
          request.resource.data.from != request.resource.data.to &&
          request.resource.data.to ==
            getAfter(/databases/$(database)/documents/resultSubmissions/$(matchId)).data.status &&
          (
            (
              request.resource.data.actor == 'submitting_team' &&
              canManageTeamById(
                getAfter(/databases/$(database)/documents/resultSubmissions/$(matchId))
                  .data.submittedByTeamId
              )
            ) ||
            (
              request.resource.data.actor == 'opponent_team' &&
              canManageTeamById(
                getAfter(/databases/$(database)/documents/resultSubmissions/$(matchId))
                  .data.opponentTeamId
              )
            ) ||
            (
              request.resource.data.actor == 'league_admin' &&
              canManageLeagueById(
                getAfter(/databases/$(database)/documents/resultSubmissions/$(matchId))
                  .data.leagueId
              )
            )
          ) &&
          (
            (
              !exists(/databases/$(database)/documents/resultSubmissions/$(matchId)) &&
              request.resource.data.from == null
            ) ||
            (
              exists(/databases/$(database)/documents/resultSubmissions/$(matchId)) &&
              request.resource.data.from ==
                get(/databases/$(database)/documents/resultSubmissions/$(matchId)).data.status
            )
          );
        allow update: if false;
        allow delete: if false;
      }
    }

    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if canManageAthleteById(request.resource.data.athleteId) &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status == 'proposed' &&
        request.resource.data.fundingModel in ['non_cash', 'sponsor_grant'] &&
        request.resource.data.verificationStatus == 'pending' &&
        request.resource.data.totalPledged == 0 &&
        request.resource.data.supportersCount == 0 &&
        !('termsLockedAt' in request.resource.data) &&
        !('outcomeVerifiedByUserId' in request.resource.data);
      // Approvals and state changes go through the trusted transition endpoint.
      allow update, delete: if false;

      match /events/{eventId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /challengeApprovals/{approvalId} {
      allow read: if isPlatformAdmin() ||
        canManageLeagueById(resource.data.leagueId) ||
        canManageTeamById(resource.data.teamId) ||
        canManageAthleteById(resource.data.athleteId);
      allow write: if false;
    }

    match /challengeOutcomes/{outcomeId} {
      allow read: if true;
      allow write: if false;
    }

    match /rosters/{rosterId} {
      allow read: if true;
      allow create: if canManageTeamById(request.resource.data.teamId) &&
        request.resource.data.submittedByUserId == request.auth.uid &&
        request.resource.data.status in ['draft', 'submitted'] &&
        !('approvedByUserId' in request.resource.data);
      allow update: if canManageTeamById(resource.data.teamId) &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.leagueId == resource.data.leagueId &&
        request.resource.data.seasonId == resource.data.seasonId &&
        resource.data.status in ['draft', 'returned'] &&
        request.resource.data.status in ['draft', 'submitted'] &&
        changedKeysWithin([
          'athleteIds', 'status', 'completeness', 'submittedByUserId', 'updatedAt'
        ]);
      allow update: if canManageLeagueById(resource.data.leagueId) &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.leagueId == resource.data.leagueId &&
        request.resource.data.seasonId == resource.data.seasonId &&
        request.resource.data.athleteIds == resource.data.athleteIds &&
        request.resource.data.completeness == resource.data.completeness &&
        resource.data.status == 'submitted' &&
        request.resource.data.status in ['confirmed', 'returned'] &&
        request.resource.data.approvedByUserId == request.auth.uid &&
        changedKeysWithin(['status', 'approvedByUserId', 'updatedAt']);
      allow delete: if false;
    }

    match /teamAssignments/{assignmentId} {
      allow get: if isPlatformAdmin() ||
        canManageLeagueById(resource.data.leagueId) ||
        (signedIn() && (
          resource.data.userId == request.auth.uid ||
          (
            resource.data.invitedEmail is string &&
            request.auth.token.get('email', '') is string &&
            resource.data.invitedEmail == request.auth.token.get('email', '')
          )
        ));
      allow list: if isPlatformAdmin() || canManageLeagueById(resource.data.leagueId);
      allow create: if false;
      // Acceptance and assignment changes are handled by the trusted access endpoint.
      allow update, delete: if false;
    }

    match /leagueNotices/{noticeId} {
      allow read: if resource.data.audience == 'public' ||
        isPlatformAdmin() ||
        canManageLeagueById(resource.data.leagueId);
      allow create: if canManageLeagueById(request.resource.data.leagueId) &&
        request.resource.data.publishedByUserId == request.auth.uid;
      allow update: if canManageLeagueById(resource.data.leagueId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'leagueId', 'seasonId', 'publishedByUserId', 'createdAt'
        ]);
      allow delete: if false;
    }

    match /supportNeeds/{needId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.raisedAmount == 0 &&
        request.resource.data.status == 'open' &&
        request.resource.data.approvalStatus == 'proposed' &&
        request.resource.data.verificationStatus == 'pending' &&
        request.resource.data.payoutDestinationStatus == 'pending_verification' &&
        (
          canManageLeagueById(request.resource.data.leagueId) ||
          (
            request.resource.data.athleteId is string &&
            canManageAthleteById(request.resource.data.athleteId)
          ) ||
          (
            request.resource.data.teamId is string &&
            canManageTeamById(request.resource.data.teamId)
          )
        );
      allow update: if
        (
          signedIn() &&
          resource.data.createdByUserId == request.auth.uid &&
          resource.data.verificationStatus == 'verified' &&
          resource.data.status != 'completed' &&
          changedKeysWithin(['recipientUpdates', 'updatedAt'])
        );
      allow delete: if false;
    }

    match /supportNeedApprovals/{approvalId} {
      allow read: if isPlatformAdmin() ||
        canManageLeagueById(resource.data.leagueId) ||
        canManageTeamById(resource.data.teamId) ||
        canManageAthleteById(resource.data.athleteId);
      allow write: if false;
    }

    match /supportNeedCompletions/{completionId} {
      allow read: if isPlatformAdmin() ||
        canManageLeagueById(resource.data.leagueId) ||
        canManageTeamById(resource.data.teamId) ||
        canManageAthleteById(resource.data.athleteId);
      allow write: if false;
    }

    match /recipientEligibility/{eligibilityId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /supportReservations/{reservationId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /leagueAdminApplications/{applicationId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isPlatformAdmin();
      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() &&
          resource.data.invitedEmail is string &&
          request.auth.token.email is string &&
          resource.data.invitedEmail == request.auth.token.email);
      allow write: if false;
    }

    match /accessAssignments/{assignmentId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /accessIndex/{indexId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // The upload lifecycle is entirely server-owned. A client that could write these
    // could authorize its own upload, mark it confirmed, or approve its own moderation.
    match /uploadSessions/{sessionId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.actorUserId == request.auth.uid);
      allow write: if false;
    }

    match /mediaRecords/{mediaId} {
      // Published media is public; anything still awaiting moderation is not.
      allow read: if resource.data.published == true
        || isPlatformAdmin()
        || (signedIn() && resource.data.actorUserId == request.auth.uid);
      allow write: if false;
    }

    // Public discovery projection. Contains only fields already public on the entity's
    // own page, and is written solely by the index builder.
    match /searchIndex/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    match /officialMatchReconciliation/{reconciliationId} {
      allow read: if true;
      allow write: if false;
    }

    match /securityEvents/{eventId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /adminAuditEvents/{eventId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /sponsorReports/{reportId} {
      allow read: if isPlatformAdmin() ||
        canManageLeagueById(resource.data.leagueId);
      allow write: if false;
    }

    match /sponsorCampaigns/{campaignId} {
      allow read: if true;
      // Command-owned: no browser client writes these, and none should.
      allow write: if false;
    }

    match /standings/{standingId} {
      allow read: if true;
      allow write: if false;
    }

    match /finalizations/{finalizationId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /feedPosts/{postId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.likesCount == 0 &&
        request.resource.data.commentsCount == 0 &&
        request.resource.data.sharesCount == 0 &&
        (
          request.resource.data.verified == false ||
          isPlatformAdmin() ||
          (
            request.resource.data.relatedTeamId is string &&
            canManageTeamById(request.resource.data.relatedTeamId)
          ) ||
          (
            request.resource.data.relatedLeagueId is string &&
            canManageLeagueById(request.resource.data.relatedLeagueId)
          ) ||
          (
            request.resource.data.relatedAthleteId is string &&
            canManageAthleteById(request.resource.data.relatedAthleteId)
          )
        );
      allow update: if
        (
          signedIn() &&
          resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId &&
          changedKeysWithin(['caption', 'mediaUrl', 'mediaURL', 'mediaType', 'updatedAt'])
        );
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if resource.data.status == 'published' ||
        isPlatformAdmin() ||
        (signedIn() && resource.data.authorId == request.auth.uid);
      allow write: if false;
    }

    match /feedReactions/{reactionId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /feedShares/{shareId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /engagementRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /supportPledges/{pledgeId} {
      // Legacy investor-demo archive. New support uses provider-owned payment intents.
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.fanId == request.auth.uid);
      allow write: if false;
    }

    match /walletTransactions/{transactionId} {
      // Legacy read-only records; GoalPlace256 does not operate a stored-value wallet.
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /paymentIntents/{intentId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.supporterUserId == request.auth.uid);
      allow write: if false;
    }

    match /contributions/{contributionId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.supporterUserId == request.auth.uid);
      allow write: if false;
    }

    match /pointsEvents/{eventId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /leagueNoticeReads/{readId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /athleteShareEvents/{eventId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /matchAttendance/{attendanceId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /ledgerTransactions/{transactionId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /ledgerEntries/{entryId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /paymentWebhookEvents/{eventId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /paymentProviderAttempts/{attemptId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /allocations/{allocationId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /payouts/{payoutId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /refunds/{refundId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /chargebacks/{chargebackId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /settlements/{settlementId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /complianceCases/{caseId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // GoalPlace Fantasy is free to play and consumes official sport records. Every
    // competitive output is server-owned so a client cannot manufacture points, prices,
    // corrections, or rank. Authenticated actions pass through validation APIs.
    match /fantasyCompetitions/{competitionId} {
      allow read: if true;
      allow write: if false;
    }

    match /fantasyScoringProfiles/{profileId} {
      allow read: if true;
      allow write: if false;
    }

    match /fantasySquadRules/{rulesId} {
      allow read: if true;
      allow write: if false;
    }

    match /fantasyRounds/{roundId} {
      allow read: if true;
      allow write: if false;
    }

    match /fantasyPlayers/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    match /fantasyPlayerPrices/{priceId} {
      allow read: if true;
      allow write: if false;
    }

    match /fantasyTeams/{teamId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /fantasyLineupVersions/{lineupId} {
      allow read: if isPlatformAdmin() ||
        (
          signedIn() &&
          get(/databases/$(database)/documents/fantasyTeams/$(resource.data.fantasyTeamId)).data.userId == request.auth.uid
        );
      allow write: if false;
    }

    match /fantasyTransfers/{transferId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /fantasyPointEvents/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /fantasyRoundScores/{scoreId} {
      allow read: if true;
      allow write: if false;
    }

    match /fantasyLeaderboards/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    match /fantasyMiniLeagues/{leagueId} {
      allow read: if resource.data.visibility == 'public' ||
        isPlatformAdmin() ||
        (
          signedIn() &&
          (
            resource.data.ownerUserId == request.auth.uid ||
            (
              exists(/databases/$(database)/documents/fantasyMiniLeagueMembers/$(leagueId + '_' + request.auth.uid)) &&
              get(/databases/$(database)/documents/fantasyMiniLeagueMembers/$(leagueId + '_' + request.auth.uid)).data.status == 'active'
            )
          )
        );
      allow write: if false;
    }

    match /fantasyMiniLeagueMembers/{memberId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid) ||
        (
          signedIn() &&
          get(/databases/$(database)/documents/fantasyMiniLeagues/$(resource.data.miniLeagueId)).data.ownerUserId == request.auth.uid
        );
      allow write: if false;
    }

    match /fantasyAchievements/{achievementId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /fantasyCorrections/{correctionId} {
      allow read: if true;
      allow write: if false;
    }

    match /fantasyAuditEvents/{eventId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /officialAthleteMatchStats/{statId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /publicInquiries/{inquiryId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /publicInquiryRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /ledgerAccounts/{accountId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      // Created by the audited server command, never from a browser.
      allow create: if false;
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if
        (
          signedIn() &&
          resource.data.userId == request.auth.uid &&
          changedKeysWithin(['read'])
        );
      allow delete: if false;
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      // Command-owned: no browser client writes these, and none should.
      allow write: if false;
      // Sponsor records carry no scoped assignment model of their own, so the legacy
      // array here is retired outright rather than migrated: platform operators manage
      // sponsors through trusted commands.
      allow write: if false;
      allow delete: if false;
    }

    match /awards/{awardId} {
      allow read: if true;
      // Command-owned: no browser client writes these, and none should.
      allow write: if false;
      allow delete: if false;
    }

    match /verifications/{verificationId} {
      allow read: if isPlatformAdmin() || canManageLeagueById(resource.data.leagueId);
      allow create: if canManageLeagueById(request.resource.data.leagueId) || isPlatformAdmin();
      allow update: if canManageLeagueById(resource.data.leagueId) || isPlatformAdmin();
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isPlatformAdmin() ||
        (signedIn() && resource.data.reporterId == request.auth.uid);
      allow write: if false;
    }

    match /adminLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // Public site copy and feature visibility. Readable by anyone because the public site
    // renders from it; writable by nobody through this path. Every change goes through the
    // audited settings command, which is also what keeps governed switches — traffic
    // routing, payments, finalizer mode, environment activation — off this document.
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Athlete payout identity. Denied to every client credential this rule can reach.
    //
    // Payout details are read by exactly one thing — the server command that hands them to
    // the payment provider — and a console that can display an account number is a console
    // that can leak one. Every other surface asks "can this athlete be paid", which the API
    // answers from a redacted view without the details ever reaching a browser.
    //
    // One honest caveat: Firestore evaluates every matching rule and grants on ANY allow, so
    // the `{document=**}` super_admin read grant at the bottom of this file still reaches
    // this collection and no deny here can override it. Closing that requires narrowing the
    // catch-all, which in turn requires explicitly modelling the ~16 collections currently
    // relying on it — a separate, deliberate change. Until then the super_admin path is the
    // known residual exposure, and it is stated here rather than implied away.
    match /athletePayees/{athleteId} {
      allow read, write: if false;
    }


    // Deny by default, including super_admin.
    //
    // This used to grant super_admin a blanket read of anything without an explicit rule,
    // which sounds like a break-glass convenience and is actually a hole no specific rule can
    // close: Firestore grants on ANY matching allow, so `athletePayees` denying everyone was
    // overridden here for one role. Payout destinations are not normal admin data.
    //
    // Narrowing it is only safe because this ruleset models every collection the client
    // reads. A new collection now starts unreadable, which is the right default — the fix is
    // to write its rule, not to fall back on a role.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
