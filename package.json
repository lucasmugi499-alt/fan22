{
  "name": "goalplace256",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_DATA_MODE=mock next dev",
    "dev:firebase": "NEXT_PUBLIC_DATA_MODE=firebase next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:mock": "tsx --env-file=.env.local scripts/seed-mock-data.ts",
    "seed:firebase": "tsx scripts/seed-firestore.ts",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "export:mock": "tsx scripts/export-mock-json.ts",
    "backup:firestore": "tsx scripts/backup-firestore.ts",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.ts",
    "seed:investor-demo": "tsx scripts/seed-investor-demo.ts",
    "set-admin-claims": "node --experimental-strip-types scripts/set-admin-claims.ts",
    "reset:demo": "node --experimental-strip-types scripts/reset-demo-data.ts",
    "test:rules": "firebase emulators:exec --only firestore --project goalplace256-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "functions:build": "npm --prefix functions run build",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "clean:preview": "tsx scripts/clean-preview.ts",
    "clean:execute": "tsx scripts/clean-execute.ts",
    "deploy:staging": "firebase deploy --project staging --config firebase.staging.json --only firestore:fg256",
    "deploy:staging:functions": "firebase deploy --project staging --config firebase.staging.json --only functions",
    "deploy:prod:rules-candidate": "firebase deploy --project manifest-quasar-479416-s7 --config firebase.production-candidate.json --only firestore:fg256",
    "deploy:prod": "firebase deploy --project manifest-quasar-479416-s7 --only firestore:fg256,functions",
    "create:owner": "tsx scripts/create-owner.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "idb-keyval": "^6.3.0",
    "motion": "^12.40.0",
    "next": "^16.2.12",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "roundrobin": "^2.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@emnapi/wasi-threads": "^1.2.3",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "firebase-tools": "^15.24.0",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
