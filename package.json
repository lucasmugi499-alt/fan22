{
  "name": "goalplace256",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_DATA_MODE=mock next dev",
    "dev:firebase": "NEXT_PUBLIC_DATA_MODE=firebase next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:audit": "tsx scripts/release/advisory-gate.ts",
    "deploy:ready": "npm run lint && npm test && npm run test:rules && npm run test:integration && npm run functions:typecheck && npm run functions:build && npm run demo:validate && npm run access:compat && npm run access:guard && npm run data:guard && npm run security:audit && npm run build",
    "deploy:ready:production": "npm run deploy:ready && npm run prod:assert-clean",
    "seed:mock": "tsx --env-file=.env.local scripts/seed-mock-data.ts",
    "seed:firebase": "tsx scripts/seed-firestore.ts",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "export:mock": "tsx scripts/export-mock-json.ts",
    "backup:firestore": "tsx scripts/backup-firestore.ts",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.ts",
    "seed:investor-demo": "tsx scripts/seed-investor-demo.ts",
    "sync:staging-fantasy": "tsx scripts/seed-investor-demo.ts --project studio-534174814-9df36 --database fg256 --merge-fantasy",
    "staging:role-smoke": "tsx --env-file=.env.local scripts/staging/role-auth-firestore-smoke.ts",
    "staging:fantasy-smoke": "tsx --env-file=.env.local scripts/staging/fantasy-auth-firestore-smoke.ts",
    "set-admin-claims": "node --experimental-strip-types scripts/set-admin-claims.ts",
    "reset:demo": "node --experimental-strip-types scripts/reset-demo-data.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage --project goalplace256-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "functions:build": "npm --prefix functions run build",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "access:compat": "tsx scripts/access/compatibility-report.ts",
    "access:guard": "tsx scripts/access/legacy-authority-guard.ts",
    "access:migrate:dry-run": "tsx scripts/access/projection-migration.ts",
    "access:migrate:apply": "tsx scripts/access/projection-migration.ts --firebase --apply",
    "access:migrate:gate": "tsx scripts/access/projection-migration.ts --firebase --strict",
    "access:backfill:dry-run": "tsx scripts/access/backfill-assignments.ts",
    "access:backfill:apply": "tsx scripts/access/backfill-assignments.ts --apply",
    "search:index:dry-run": "tsx scripts/search/build-index.ts",
    "search:index:apply": "tsx scripts/search/build-index.ts --apply",
    "clean:preview": "tsx scripts/clean-preview.ts",
    "clean:execute": "tsx scripts/clean-execute.ts",
    "deploy:preflight": "tsx scripts/deploy/preflight.ts",
    "deploy:staging:candidate": "npm run deploy:preflight -- --environment=staging --project=staging --config=firebase.staging.json && firebase deploy --project staging --config firebase.staging.json --only firestore:fg256",
    "deploy:staging:functions": "npm run deploy:preflight -- --environment=staging --project=staging --config=firebase.staging.json && firebase deploy --project staging --config firebase.staging.json --only functions",
    "deploy:demo:candidate": "npm run deploy:preflight -- --environment=demo --project=demo --config=firebase.json && firebase deploy --project demo --config firebase.json --only firestore:fg256",
    "deploy:prod:candidate-after-approval": "npm run deploy:preflight -- --environment=production --project=production --config=firebase.production-candidate.json && firebase deploy --project production --config firebase.production-candidate.json --only firestore:fg256",
    "deploy:prod:legacy-blocked": "node -e \"throw new Error('Legacy production deploy is blocked. Use the reviewed candidate path after explicit approval.')\"",
    "create:owner": "tsx scripts/create-owner.ts",
    "environment:status": "tsx scripts/environment/activate.ts --action=status",
    "environment:prepare:demo": "tsx scripts/environment/activate.ts --action=activate --environment=demo",
    "environment:prepare:beta": "tsx scripts/environment/activate.ts --action=activate --environment=beta",
    "environment:prepare:production": "tsx scripts/environment/activate.ts --action=activate --environment=production",
    "environment:maintenance": "tsx scripts/environment/activate.ts --action=maintenance",
    "environment:rollback": "tsx scripts/environment/activate.ts --action=rollback",
    "environment:probe": "tsx scripts/environment/probe.ts",
    "restore:firestore": "tsx scripts/restore-firestore.ts",
    "prod:assert-clean": "tsx scripts/prod/assert-clean.ts",
    "demo:export": "tsx scripts/demo/data-lifecycle.ts --action=export",
    "demo:validate": "tsx scripts/demo/data-lifecycle.ts --action=validate",
    "demo:recompute-index": "tsx scripts/demo/recompute-index.ts",
    "demo:recompute-index:apply": "tsx scripts/demo/recompute-index.ts --apply",
    "demo:reset": "tsx scripts/demo/data-lifecycle.ts --action=demo-reset",
    "beta:seed": "tsx scripts/demo/data-lifecycle.ts --action=beta-seed",
    "beta:reset": "tsx scripts/demo/data-lifecycle.ts --action=beta-reset",
    "data:guard": "tsx scripts/data/deprecated-fields-guard.ts",
    "league-index:rebuild": "tsx --env-file=.env.local scripts/leagueIndex/rebuild.ts",
    "firestore:discovery-indexes": "tsx scripts/firestore/discovery-indexes.ts",
    "firestore:discovery-indexes:apply": "tsx scripts/firestore/discovery-indexes.ts --apply",
    "standings:verify": "tsx --env-file=.env.local scripts/standings/verify-demo.ts",
    "standings:rebuild:dry-run": "tsx --env-file=.env.local scripts/standings/rebuild.ts",
    "standings:rebuild:apply": "tsx --env-file=.env.local scripts/standings/rebuild.ts --apply",
    "data:repair:aggregates:dry-run": "tsx --env-file=.env.local scripts/data/repair-team-aggregates.ts",
    "data:repair:aggregates:apply": "tsx --env-file=.env.local scripts/data/repair-team-aggregates.ts --apply",
    "postinstall": "npm --prefix functions ci",
    "bootstrap": "npm ci && npm --prefix functions ci",
    "rules:smoke": "tsx --env-file=.env.local scripts/staging/deployed-rules-smoke.ts",
    "canary:finalizer": "tsx --env-file=.env.local scripts/security/finalizer-canary.ts",
    "lifecycle:report": "tsx --env-file=.env.local scripts/security/lifecycle-report.ts",
    "access:v1-drain": "tsx scripts/access/v1-drain-report.ts",
    "data:migrate-athlete-identity": "tsx scripts/data/migrate-athlete-identity.ts",
    "test:integration": "firebase emulators:exec --only firestore --project goalplace256-integration \"vitest run --config vitest.integration.config.ts\"",
    "access:migrate-v1": "tsx scripts/access/migrate-v1-workflow.ts",
    "access:sunset-invariants": "tsx scripts/access/team-sunset-invariants.ts",
    "release:evidence": "tsx scripts/release/migration-evidence.ts",
    "release:canary": "tsx scripts/release/field-capture-canary.ts",
    "release:unreported-sweep": "tsx scripts/release/unreported-match-sweep.ts",
    "release:unreported-canary": "tsx scripts/release/unreported-match-canary.ts",
    "standings:backfill-season-teams": "tsx --env-file=.env.local scripts/standings/backfill-season-teams.ts",
    "standings:backfill-season-teams:apply": "tsx --env-file=.env.local scripts/standings/backfill-season-teams.ts --apply",
    "data:repair-scores": "tsx --env-file=.env.local scripts/data/repair-implausible-scores.ts",
    "data:repair-scores:apply": "tsx --env-file=.env.local scripts/data/repair-implausible-scores.ts --apply"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^10.9.1",
    "idb-keyval": "^6.3.0",
    "motion": "^12.40.0",
    "next": "^16.3.2",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "roundrobin": "^2.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@emnapi/wasi-threads": "^1.2.3",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "firebase-tools": "^15.28.1",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "re2": "1.26.1",
    "next": {
      "sharp": "0.35.3"
    },
    "nanoid": "^3.3.18",
    "firebase-admin": {
      "uuid": "^11.1.1"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
