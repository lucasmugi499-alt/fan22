FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_DEMO_PASSWORD=

# Set to "true" to expose demo role login on a deployed build (never on production).
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=

# Payments remain sandbox-only. `sandbox` is the only provider that is safe to enable
# without a provider onboarding contract and test credentials.
# The current implementation accepts only "sandbox"; production activation also requires
# the legal, PSP, KYC, payout, refund, tax, and PDPO gates in docs/MONEY_ENGINE.md.
GOALPLACE_PAYMENTS_MODE=
GOALPLACE_PAYMENT_PROVIDER=
GOALPLACE_PAYMENT_WEBHOOK_SECRET=
GOALPLACE_MTN_MOMO_BASE_URL=
GOALPLACE_MTN_MOMO_TARGET_ENVIRONMENT=
GOALPLACE_MTN_MOMO_COLLECTION_API_USER=
GOALPLACE_MTN_MOMO_COLLECTION_API_KEY=
GOALPLACE_MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
GOALPLACE_MTN_MOMO_DISBURSEMENT_API_USER=
GOALPLACE_MTN_MOMO_DISBURSEMENT_API_KEY=
GOALPLACE_MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
GOALPLACE_AIRTEL_TOKEN_URL=
GOALPLACE_AIRTEL_COLLECTION_URL=
GOALPLACE_AIRTEL_COLLECTION_STATUS_URL=
GOALPLACE_AIRTEL_DISBURSEMENT_URL=
GOALPLACE_AIRTEL_DISBURSEMENT_STATUS_URL=
GOALPLACE_AIRTEL_CLIENT_ID=
GOALPLACE_AIRTEL_CLIENT_SECRET=
GOALPLACE_AIRTEL_COUNTRY=UG
GOALPLACE_AIRTEL_CALLBACK_SECRET=
GOALPLACE_ATTENDANCE_SECRET=

# Client UI only. Set to "psp" after the server payment contract is configured.
NEXT_PUBLIC_PAYMENTS_MODE=
