NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# No NEXT_PUBLIC_ prefix, ever. Next inlines anything carrying that prefix into the client
# bundle at build time, so a prefixed password is published rather than configured. This
# variable used to carry it. Only Node scripts read it, so it was never actually in a bundle
# — which is precisely what made it dangerous: nothing was broken, nothing drew attention,
# and the first component to reach for a demo password would have found a plausibly-named
# variable and published it silently.
# scripts/lib/publicEnvNames.test.ts now fails on any secret-shaped public name.
FIREBASE_DEMO_PASSWORD=

# Transactional email. Store RESEND_API_KEY in your local secret store or Firebase
# App Hosting Secret Manager; do not commit a real key.
RESEND_API_KEY=
GOALPLACE_EMAIL_FROM=GoalPlace256 <onboarding@resend.dev>
GOALPLACE_EMAIL_REPLY_TO=
GOALPLACE_APP_BASE_URL=

# Set to "true" to expose demo role login on a deployed build (never on production).
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=

# Payments remain sandbox-only. Airtel remains contract_pending until official Uganda
# sandbox fixtures and callback authentication are captured from the partner portal.
GOALPLACE_PAYMENTS_MODE=
GOALPLACE_ENABLED_PAYMENT_PROVIDERS=airtel_money,mtn_momo
GOALPLACE_PAYMENT_CALLBACK_BASE_URL=
GOALPLACE_RECONCILIATION_SECRET=
GOALPLACE_FANTASY_SCORING_SECRET=
GOALPLACE_PAYMENT_WEBHOOK_SECRET=
GOALPLACE_MTN_MOMO_BASE_URL=
GOALPLACE_MTN_MOMO_TARGET_ENVIRONMENT=
GOALPLACE_MTN_MOMO_CURRENCY=EUR
GOALPLACE_MTN_MOMO_COLLECTION_API_USER=
GOALPLACE_MTN_MOMO_COLLECTION_API_KEY=
GOALPLACE_MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
GOALPLACE_MTN_MOMO_DISBURSEMENT_API_USER=
GOALPLACE_MTN_MOMO_DISBURSEMENT_API_KEY=
GOALPLACE_MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
GOALPLACE_AIRTEL_TOKEN_URL=
GOALPLACE_AIRTEL_COLLECTION_URL=
GOALPLACE_AIRTEL_COLLECTION_STATUS_URL=
GOALPLACE_AIRTEL_DISBURSEMENT_URL=
GOALPLACE_AIRTEL_DISBURSEMENT_STATUS_URL=
GOALPLACE_AIRTEL_CLIENT_ID=
GOALPLACE_AIRTEL_CLIENT_SECRET=
GOALPLACE_AIRTEL_COUNTRY=UG
GOALPLACE_AIRTEL_CONTRACT_STATUS=contract_pending
GOALPLACE_ATTENDANCE_SECRET=

# Client UI only. Set to "psp" after the server payment contract is configured.
NEXT_PUBLIC_PAYMENTS_MODE=
