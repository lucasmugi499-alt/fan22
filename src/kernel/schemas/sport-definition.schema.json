{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goalplace256.com/schemas/sport-definition.schema.json",
  "title": "SportDefinition",
  "type": "object",
  "required": ["id", "version", "schemaVersion", "status", "sportId", "name", "legalScoringEvents", "contentHash"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "schemaVersion": { "type": "string" },
    "status": { "enum": ["draft", "validated", "reviewed", "approved", "scheduled", "active", "retired"] },
    "sportId": { "enum": ["football", "basketball", "rugby"] },
    "name": { "type": "string", "minLength": 1 },
    "contentHash": { "type": "string", "minLength": 1 },
    "legalScoringEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["eventType", "points"],
        "properties": {
          "eventType": { "type": "string", "minLength": 1 },
          "points": { "type": "number" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
