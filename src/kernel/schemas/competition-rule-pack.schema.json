{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goalplace256.com/schemas/competition-rule-pack.schema.json",
  "title": "CompetitionRulePack",
  "type": "object",
  "required": ["id", "version", "schemaVersion", "status", "sportId", "resultPoints", "bonusRules", "tieBreakers", "contentHash"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "schemaVersion": { "type": "string" },
    "status": { "enum": ["draft", "validated", "reviewed", "approved", "scheduled", "active", "retired"] },
    "sportId": { "enum": ["football", "basketball", "rugby"] },
    "contentHash": { "type": "string" },
    "resultPoints": {
      "type": "object",
      "required": ["win", "loss"],
      "properties": {
        "win": { "type": "number" },
        "draw": { "type": "number" },
        "loss": { "type": "number" }
      }
    },
    "bonusRules": { "type": "array" },
    "tieBreakers": { "type": "array", "minItems": 1 }
  }
}
