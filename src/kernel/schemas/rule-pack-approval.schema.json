{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goalplace256.com/schemas/rule-pack-approval.schema.json",
  "title": "RulePackApproval",
  "type": "object",
  "required": ["id", "rulePackId", "rulePackVersion", "status", "requestedByUserId", "createdAt"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "rulePackId": { "type": "string" },
    "rulePackVersion": { "type": "string" },
    "status": { "enum": ["draft", "validated", "simulated", "reviewed", "approved", "scheduled", "active", "retired"] },
    "requestedByUserId": { "type": "string" },
    "approvedByUserIds": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string" },
    "approvedAt": { "type": "string" }
  }
}
