rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.keys().hasAny(['role']) ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == 'platform_admin' || role() == 'super_admin';
    }

    function validMedia() {
      return request.resource != null &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|video/.*');
    }

    function validPublicOwner(ownerType) {
      return ownerType in ['athletes', 'teams', 'leagues', 'feed'];
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId && validMedia();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if resource != null &&
        request.resource == null &&
        (isAdmin() || (signedIn() && request.auth.uid == userId));
    }

    // Match evidence backing a result submission.
    //
    // This previously had nowhere to live: the only writable paths were /public (world
    // readable AND writable by any signed-in user, so an opposing team could read or
    // overwrite disputed-match evidence) and /users. Evidence is scoped to the match and
    // the uploading team, readable only by signed-in users, and never overwritable or
    // deletable by the uploader — evidence that can be swapped after a dispute opens is
    // not evidence.
    //
    // The 15MB cap is deliberately lower than the 50MB media ceiling: uploads happen from
    // the touchline on Ugandan mobile data, and the client compresses before sending.
    function validEvidence() {
      return request.resource != null &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|video/.*');
    }

    match /matchEvidence/{matchId}/{teamId}/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if resource == null && signedIn() && request.auth.uid == userId && validEvidence();
      allow update: if false;
      allow delete: if isAdmin();
      allow write: if resource != null && request.resource == null && isAdmin();
    }

    match /publishedMedia/{ownerType}/{ownerId}/{userId}/{fileName} {
      allow read: if true;
      allow create: if resource == null &&
        signedIn() &&
        ownerType in ['user', 'athlete', 'team', 'league'] &&
        request.auth.uid == userId &&
        validEvidence() &&
        request.resource.metadata.ownerType == ownerType &&
        request.resource.metadata.ownerId == ownerId &&
        request.resource.metadata.uploadedBy == userId;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if resource != null &&
        request.resource == null &&
        (isAdmin() || (signedIn() && request.auth.uid == userId));
    }

    match /approvedMedia/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validMedia();
      allow delete: if isAdmin();
      allow write: if isAdmin() && (request.resource == null || validMedia());
    }

    match /public/{ownerType}/{ownerId}/{userId}/{fileName} {
      allow read: if true;
      allow create: if resource == null &&
        signedIn() &&
        validPublicOwner(ownerType) &&
        request.auth.uid == userId &&
        validMedia() &&
        request.resource.metadata.ownerType == ownerType &&
        request.resource.metadata.ownerId == ownerId &&
        request.resource.metadata.uploadedBy == userId;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if resource != null &&
        request.resource == null &&
        (isAdmin() || (signedIn() && request.auth.uid == userId));
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /moderation/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read: if role() == 'super_admin';
      allow write: if false;
    }
  }
}
